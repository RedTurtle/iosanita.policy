<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="iosanita.policy"
    >

  <include
      package="z3c.jbot"
      file="meta.zcml"
      />

  <browser:page
      name="iosanita-settings"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".controlpanel.IoSanitaControlPanel"
      permission="cmf.ManagePortal"
      layer="iosanita.policy.interfaces.IIosanitaPolicyLayer"
      />


  <!-- export views -->
  <browser:page
      name="export_pdf_template"
      for="*"
      template="templates/export_pdf_template.pt"
      permission="zope2.View"
      layer="iosanita.policy.interfaces.IIosanitaPolicyLayer"
      />

  <browser:page
      name="download"
      for=".listing_block_export.IListingBlockExportViewTraverser"
      class=".listing_block_export.ListingBlockExportViewDownload"
      permission="zope2.View"
      layer="iosanita.policy.interfaces.IIosanitaPolicyLayer"
      />

  <browser:page
      name="listing-block-export"
      for="plone.dexterity.interfaces.IDexterityContent"
      class=".listing_block_export.ListingBlockExportViewTraverser"
      permission="zope2.View"
      layer="iosanita.policy.interfaces.IIosanitaPolicyLayer"
      />

</configure>
